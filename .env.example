# ── Work IQ (reuses the same app registration as ../workiq-demo) ────────────
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
WORKIQ_MCP=https://workiq.svc.cloud.microsoft/mcp

# ── Fabric IQ (Fabric Data Agent) ────────────────────────────────────────────
# Auth: DefaultAzureCredential (az login / managed identity / service principal).
FABRIC_WORKSPACE_ID=e1460756-8da2-44e0-9ec6-a02008ed0ec8
FABRIC_DATA_AGENT_ID=74f3f165-0654-4321-be76-8e282eddbc28

# ── Foundry IQ (Azure AI Search Knowledge Base) ──────────────────────────────
AZURE_SEARCH_ENDPOINT=https://aiworkshop-search-rmsgmwk472oxi.search.windows.net
AZURE_SEARCH_INDEX_NAME=all-iq-demo-policies
AZURE_SEARCH_ADMIN_KEY=
FOUNDRY_KNOWLEDGE_BASE_NAME=all-iq-demo-kb
PROJECT_ENDPOINT=https://aiworkshop-foundry-rmsgmwk472oxi.services.ai.azure.com/api/projects/proj-default
PROJECT_RESOURCE_ID=
AZURE_OPENAI_ENDPOINT=https://aiworkshop-foundry-rmsgmwk472oxi.openai.azure.com/
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AGENT_MODEL=gpt-4o

# ── Web IQ ────────────────────────────────────────────────────────────────────
# Request access at https://aka.ms/webiq-waitlist if you don't have a key yet.
WEBIQ_API_KEY=
WEBIQ_BASE_URL=https://api.microsoft.ai/v3
WEBIQ_MCP_URL=https://api.microsoft.ai/v3/mcp

# ── Orchestrator ──────────────────────────────────────────────────────────────
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8010
